{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digital Forge Video Studio",
  "version": "0.7.0",
  "identifier": "com.digitalforge.videostudio",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Digital Forge — Video Studio",
        "width": 1480,
        "height": 930,
        "minWidth": 980,
        "minHeight": 700,
        "decorations": true,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
