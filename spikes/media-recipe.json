{
  "_comment": "Test media for the Phase 0 spikes. Read by spikes/rust/spikes.rs (include_str!) and spikes/harness/server.mjs, so both generate identical files. Placeholders: {W} {H} {N} {FPS} {OUT} {DIR} {IN} {INDEX}. Every clip carries its frame index as an 8-bit strip (8 blocks of 32x32, LSB first) in the top-left corner.",
  "videoClips": [
    {
      "id": "h264-1080",
      "file": "h264-1080.mp4",
      "codec": "h264",
      "width": 1920,
      "height": 1080,
      "frames": 96,
      "fps": 24,
      "tagged": true
    },
    {
      "id": "h264-1080-untagged",
      "file": "h264-1080-untagged.mp4",
      "codec": "h264",
      "width": 1920,
      "height": 1080,
      "frames": 96,
      "fps": 24,
      "tagged": false
    },
    {
      "id": "h264-2160",
      "file": "h264-2160.mp4",
      "codec": "h264",
      "width": 3840,
      "height": 2160,
      "frames": 96,
      "fps": 24,
      "tagged": true
    },
    {
      "id": "hevc-1080",
      "file": "hevc-1080.mp4",
      "codec": "hevc",
      "width": 1920,
      "height": 1080,
      "frames": 96,
      "fps": 24,
      "tagged": true
    },
    {
      "id": "hevc-2160",
      "file": "hevc-2160.mp4",
      "codec": "hevc",
      "width": 3840,
      "height": 2160,
      "frames": 96,
      "fps": 24,
      "tagged": true
    },
    {
      "id": "vp9-1080",
      "file": "vp9-1080.mp4",
      "codec": "vp9",
      "width": 1920,
      "height": 1080,
      "frames": 96,
      "fps": 24,
      "tagged": true
    }
  ],
  "videoInputArgs": [
    "-f",
    "lavfi",
    "-i",
    "testsrc2=s={W}x{H}:r={FPS}",
    "-f",
    "lavfi",
    "-i",
    "color=c=black:s=256x32:r={FPS},format=gray",
    "-filter_complex",
    "[1:v]geq=lum='255*mod(floor(N/pow(2,floor(X/32))),2)'[strip];[0:v][strip]overlay=0:0,scale=out_color_matrix=bt709:out_range=tv,format=yuv420p[v]",
    "-map",
    "[v]",
    "-frames:v",
    "{N}"
  ],
  "encoderArgs": {
    "h264": [
      "-c:v",
      "libx264",
      "-preset",
      "veryfast",
      "-crf",
      "16",
      "-g",
      "48",
      "-bf",
      "2"
    ],
    "hevc": [
      "-c:v",
      "libx265",
      "-preset",
      "fast",
      "-crf",
      "18",
      "-x265-params",
      "keyint=48:min-keyint=48:bframes=2:log-level=error",
      "-tag:v",
      "hvc1"
    ],
    "vp9": [
      "-c:v",
      "libvpx-vp9",
      "-b:v",
      "0",
      "-crf",
      "24",
      "-deadline",
      "realtime",
      "-cpu-used",
      "8",
      "-row-mt",
      "1",
      "-g",
      "48"
    ]
  },
  "tagArgs": [
    "-colorspace",
    "bt709",
    "-color_primaries",
    "bt709",
    "-color_trc",
    "bt709",
    "-color_range",
    "tv"
  ],
  "containerArgs": [
    "-movflags",
    "+faststart",
    "-an"
  ],
  "alpha": {
    "width": 832,
    "height": 480,
    "frames": 81,
    "fps": 16,
    "pngPattern": "frame_%04d.png",
    "pngArgs": [
      "-f",
      "lavfi",
      "-i",
      "color=c=black@0.0:s={W}x{H}:r={FPS},format=rgba",
      "-vf",
      "geq=r='200+55*sin(N/5)':g='128+100*sin(X/40+N/4)':b='60+Y/4':a='255*exp(-(pow(X-W/2-150*sin(N/8),2)+pow(Y-H/2-60*cos(N/6),2))/9800)'",
      "-frames:v",
      "{N}",
      "-start_number",
      "0",
      "{DIR}/frame_%04d.png"
    ],
    "stackedArgs": [
      "-framerate",
      "{FPS}",
      "-start_number",
      "0",
      "-i",
      "{DIR}/frame_%04d.png",
      "-filter_complex",
      "[0:v]split[c][a];[c]scale=out_color_matrix=bt709:out_range=tv,format=yuv420p[co];[a]alphaextract,scale=out_range=tv,format=yuv420p[al];[co][al]hstack=inputs=2[v]",
      "-map",
      "[v]",
      "-c:v",
      "libx264",
      "-preset",
      "veryfast",
      "-crf",
      "12",
      "-g",
      "16",
      "-bf",
      "2",
      "-colorspace",
      "bt709",
      "-color_primaries",
      "bt709",
      "-color_trc",
      "bt709",
      "-color_range",
      "tv",
      "-movflags",
      "+faststart",
      "{OUT}"
    ],
    "vp9Args": [
      "-framerate",
      "{FPS}",
      "-start_number",
      "0",
      "-i",
      "{DIR}/frame_%04d.png",
      "-c:v",
      "libvpx-vp9",
      "-pix_fmt",
      "yuva420p",
      "-b:v",
      "0",
      "-crf",
      "20",
      "-auto-alt-ref",
      "0",
      "-row-mt",
      "1",
      "-colorspace",
      "bt709",
      "-color_primaries",
      "bt709",
      "-color_trc",
      "bt709",
      "-color_range",
      "tv",
      "{OUT}"
    ]
  },
  "referenceVideoArgs": [
    "-i",
    "{IN}",
    "-vf",
    "select=eq(n\\,{INDEX}),scale=in_color_matrix=bt709:in_range=tv:out_range=pc:flags=bilinear+accurate_rnd+full_chroma_int,format=rgba",
    "-fps_mode",
    "passthrough",
    "-frames:v",
    "1",
    "-f",
    "rawvideo",
    "-"
  ],
  "referenceImageArgs": [
    "-i",
    "{IN}",
    "-frames:v",
    "1",
    "-f",
    "rawvideo",
    "-pix_fmt",
    "rgba",
    "-"
  ]
}
